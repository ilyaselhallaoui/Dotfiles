#!/bin/sh
# Re-runs whenever .chezmoidata/packages.yaml changes.
# apt: {{ .packages.apt | join " " }}
# brew: {{ .packages.brew | join " " }}
# mise: {{ .packages.mise | join " " }}
set -eu
PATH="$HOME/.local/bin:/home/linuxbrew/.linuxbrew/bin:/opt/homebrew/bin:$PATH"

{{ if eq .chezmoi.os "linux" -}}
sudo apt-get update -qq
sudo apt-get install -y {{ .packages.apt | join " " }}
command -v fd  >/dev/null || ln -sf "$(command -v fdfind)" ~/.local/bin/fd
command -v bat >/dev/null || ln -sf "$(command -v batcat)" ~/.local/bin/bat
{{- end }}

if command -v brew >/dev/null; then
  brew install {{ .packages.brew | join " " }}
fi

command -v mise >/dev/null || curl -fsSL https://mise.run | MISE_INSTALL_PATH="$HOME/.local/bin/mise" sh
{{- range .packages.mise }}
mise use --global {{ . | quote }}
{{- end }}
