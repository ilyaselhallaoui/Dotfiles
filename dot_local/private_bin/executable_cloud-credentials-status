#!/bin/sh
set -eu

show_path() {
  name="$1"
  path="$2"
  if [ -L "$path" ]; then
    printf '%s: symlink -> %s\n' "$name" "$(readlink "$path")"
  elif [ -e "$path" ]; then
    printf '%s: present at %s\n' "$name" "$path"
  else
    printf '%s: missing\n' "$name"
  fi
}

show_path kubeconfig "$HOME/.kube/config"
show_path aws "$HOME/.aws"
show_path azure "$HOME/.azure"
