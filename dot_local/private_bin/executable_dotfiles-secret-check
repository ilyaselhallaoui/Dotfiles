#!/bin/sh
set -eu

status=0

check_file() {
  file="$1"
  [ -f "$file" ] || return 0

  case "$file" in
    */dot_kube/config|dot_kube/config|*/private_dot_kube/config|private_dot_kube/config|\
    */dot_aws/credentials|dot_aws/credentials|*/private_dot_aws/credentials|private_dot_aws/credentials|\
    */dot_azure/*|dot_azure/*|*/private_dot_azure/*|private_dot_azure/*)
      echo "refusing raw credential path in source: $file" >&2
      status=1
      return 0
      ;;
  esac

  if ! grep -Iq . "$file"; then
    return 0
  fi

  if grep -Eiq \
    '(aws_access_key_id[[:space:]]*=|aws_secret_access_key[[:space:]]*=|aws_session_token[[:space:]]*=|client-key-data:[[:space:]]*[A-Za-z0-9+/=]{32,}|refresh[_-]?token[[:space:]]*[:=]|client[_-]?secret[[:space:]]*[:=])' \
    "$file"; then
    echo "possible credential material found in: $file" >&2
    status=1
  fi
}

if [ "$#" -eq 0 ]; then
  tmp="$(mktemp)"
  trap 'rm -f "$tmp"' EXIT
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git ls-files -co --exclude-standard >"$tmp"
  else
    find . -type f >"$tmp"
  fi
  while IFS= read -r file; do
    check_file "$file"
  done <"$tmp"
else
  for file in "$@"; do
    check_file "$file"
  done
fi

exit "$status"
